# Agreement Studio — Environment Variables
#
# Copy this file to backend/.env and fill in your Supabase credentials.
#
# DATABASE_URL: Supabase → Project Settings → Database → Connection string → URI
# SUPABASE_URL: Supabase → Project Settings → API → Project URL
# SUPABASE_SERVICE_ROLE_KEY: Supabase → Project Settings → API → service_role key

DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.mjfiasrfihchohtfzfba.supabase.co:5432/postgres
SUPABASE_URL=https://mjfiasrfihchohtfzfba.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
